{
  "name": "famille-infra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Infrastructure Firebase commune (règles de sécurité, émulateur, tests)",
  "scripts": {
    "emulators": "firebase emulators:start --project demo-famille",
    "test": "firebase emulators:exec --only firestore --project demo-famille \"vitest run\"",
    "deploy:dev": "firebase deploy --only firestore --project dev",
    "deploy:prod": "firebase deploy --only firestore --project prod"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.3.0",
    "firebase-tools": "^15.35.0",
    "vitest": "^5.1.0"
  }
}
